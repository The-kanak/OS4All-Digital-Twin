# ==============================================================================
# OS4All Backend Environment Variables Configuration Template
# ==============================================================================

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=os4all
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# JWT Authentication
# IMPORTANT: Provide a secure random secret of at least 256 bits (32+ chars) in production!
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Nebius AI Cloud / NVIDIA Nemotron Configuration (For Phase 3)
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1
NEBIUS_MODEL=nvidia/Llama-3_1-Nemotron-70B-Instruct

# Tavily Evidence Grounding Configuration (For Phase 3)
TAVILY_API_KEY=your_tavily_api_key_here

# Audit Logging
AUDIT_LOG_ENABLED=true
